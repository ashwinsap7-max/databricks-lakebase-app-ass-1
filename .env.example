# Lakebase Database Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# Lakebase endpoint host
PGHOST=ep-your-branch.aws.lakebase.databricks.com

# Database name
PGDATABASE=support-system

# Database user (your email or service principal)
PGUSER=your-email@example.com

# Database port
PGPORT=5432

# Databricks workspace URL (for authentication)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Optional: Databricks token (for local development)
# DATABRICKS_TOKEN=your-token-here